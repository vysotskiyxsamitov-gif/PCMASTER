{
  "name": "pc-master",
  "version": "1.0.0",
  "description": "PC МАСТЕР — симулятор сборки ПК",
  "main": "main.js",
  "author": "PC Master",
  "scripts": {
    "start": "node prepare.js && electron .",
    "dist": "node prepare.js && electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "three": "0.128.0"
  },
  "build": {
    "appId": "com.pcmaster.game",
    "productName": "PC MASTER",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "audio.js",
      "pause.js",
      "intro.js",
      "extras.js",
      "fx.js",
      "street.js",
      "Room.js",
      "ultra.js",
      "world.js",
      "world2.js",
      "chars.js",
      "windows.js",
      "pcvis.js",
      "chars2.js",
      "clean.js",
      "blackout.js",
      "orders.js",
      "realism.js",
      "detail.js",
      "look.js",
      "models.js",
      "mood.js",
      "bookview.js",
      "storage.js",
      "menu2.js",
      "admin.js",
      "three.min.js"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "PC-MASTER-Setup-${version}.${ext}"
    }
  }
}
